 }
 
+std::unique_ptr<EQApplicationPacket> MessageComponent::HealMessage(uint16_t target_id, uint16_t caster_id,
+	int32_t spell_id, int64_t healed, int64_t total, bool over_time, bool critical) const
+{
+	auto outapp = std::make_unique<EQApplicationPacket>(OP_CombatText64, sizeof(structs::HealMessage_Struct));
+	auto heal = reinterpret_cast<structs::HealMessage_Struct*>(outapp->pBuffer);
+	heal->target_id = target_id;
+	heal->caster_id = caster_id;
+	heal->spell_id = spell_id;
+	heal->healed = healed;
+	heal->total = total;
+	heal->flags = (over_time ? structs::HealMessageOverTime : 0) | (critical ? structs::HealMessageCritical : 0);
+
+	return outapp;
+}
+
 std::unique_ptr<EQApplicationPacket> BuffComponent::BuffDefinition(Mob* mob, const Buffs_Struct& buff, uint32_t slot, bool fade) const
 {
