+	struct HealMessage_Struct {
+		/*00*/ uint16 target_id;
+		/*02*/ uint16 caster_id;
+		/*04*/ int32  spell_id;    // -1 leaves the "by <spell>" part out
+		/*08*/ int64  healed;
+		/*16*/ int64  total;
+		/*24*/ uint32 flags;       // HealMessageFlags
+		/*28*/
+	};
+
 #pragma pack()
 
+	enum HealMessageFlags : uint32 {
+		HealMessageOverTime = 1,
+		HealMessageCritical = 4
+	};
