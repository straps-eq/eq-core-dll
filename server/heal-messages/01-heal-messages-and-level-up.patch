 	const char* spell_link);
 
+// true when the client has its own heal message (queued unless the filter hides it); false means send the heal strings
+bool SendHealMessage(Client* c, Mob* sender, eqFilterType filter, uint16 target_id, uint16 caster_id, int32 spell_id,
+	int64 healed, int64 total, bool over_time, bool critical);
+// close ToB clients other than the caster and the healed mob; the caster's spell filters decide who gets it
+void BroadcastHealMessage(Mob* healed_mob, Mob* caster, float range, int32 spell_id, int64 healed, int64 total,
+	bool over_time, bool critical);
+
 void SendFullBuffRefresh(Mob* sender, bool remove = false, bool ackreq = true, bool with_definitions = false);
 void SendSingleBuffChange(Mob* sender, const Buffs_Struct& buff, int slot, bool remove = false, bool ackreq = true);
 
