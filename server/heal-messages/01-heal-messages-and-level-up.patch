 		&IMessage::InterruptSpellOther, GetClientComponent<IMessage>, sender, message, spawn_id, name, spell_link);
 }
 
+bool ClientPatch::SendHealMessage(Client* c, Mob* sender, eqFilterType filter, uint16 target_id, uint16 caster_id,
+	int32 spell_id, int64 healed, int64 total, bool over_time, bool critical) {
+	auto component = GetClientComponent<IMessage>(c);
+	auto packet = component ? component->HealMessage(target_id, caster_id, spell_id, healed, total, over_time, critical) : nullptr;
+	if (!packet) {
+		return false;
+	}
+
+	if (c->ShouldGetPacket(sender, filter)) {
+		c->QueuePacket(packet.get());
+	}
+
+	return true;
+}
+
+void ClientPatch::BroadcastHealMessage(Mob* healed_mob, Mob* caster, float range, int32 spell_id, int64 healed,
+	int64 total, bool over_time, bool critical) {
+	QueueCloseClients(caster, true, range, healed_mob, true, caster->IsClient() ? FilterPCSpells : FilterNPCSpells)(
+		&IMessage::HealMessage, GetClientComponent<IMessage>, healed_mob->GetID(), caster->GetID(), spell_id, healed,
+		total, over_time, critical);
+}
+
 static bool ShouldSendTargetBuffs(Client* c) {
 	// this function checks for server rules against LAA and GM status to determine if a buffs packet should be sent
 	// to a client (c) for targeted mobs
