diff --git a/zone/mob.cpp b/zone/mob.cpp
index 4ac9e12a34..52cc674d2d 100644
--- a/zone/mob.cpp
+++ b/zone/mob.cpp
@@ -1554,6 +1554,9 @@ void Mob::CreateHPPacket(EQApplicationPacket* app)
 
 void Mob::SendHPUpdate(bool force_update_all)
 {
+	if (IsNPC()) {
+		CastToNPC()->SendNameplateVitals();
+	}
 
 	// If our HP is different from last HP update call - let's update selves
 	if (IsClient()) {
@@ -4474,6 +4477,10 @@ const int64& Mob::SetMana(int64 amount)
 	int64 mmana = GetMaxMana();
 	current_mana = amount < 0 ? 0 : (amount > mmana ? mmana : amount);
 
