From 2db481e58cd02881507794b868160a43cb85ff56 Mon Sep 17 00:00:00 2001
From: "straps." <straps.eq@gmail.com>
Date: Sat, 17 Oct 2026 12:18:04 -0500
Subject: [PATCH] Nameplate vitals: skip the work entirely while the range rule
 is 0

---
 zone/mob.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/zone/mob.cpp b/zone/mob.cpp
index 52cc674d2d..ee127d265f 100644
--- a/zone/mob.cpp
+++ b/zone/mob.cpp
@@ -1554,7 +1554,7 @@ void Mob::CreateHPPacket(EQApplicationPacket* app)
 
 void Mob::SendHPUpdate(bool force_update_all)
 {
-	if (IsNPC()) {
+	if (IsNPC() && RuleI(Character, ToBNameplateVitalsRange) > 0) {
 		CastToNPC()->SendNameplateVitals();
 	}
 
@@ -4477,7 +4477,7 @@ const int64& Mob::SetMana(int64 amount)
 	int64 mmana = GetMaxMana();
 	current_mana = amount < 0 ? 0 : (amount > mmana ? mmana : amount);
 
-	if (IsNPC()) {
+	if (IsNPC() && RuleI(Character, ToBNameplateVitalsRange) > 0) {
 		CastToNPC()->MarkNameplateVitalsPending();
 	}
 
-- 
